FROM node:18-alpine

WORKDIR /app

# Copiar package.json del backend
COPY backend/package*.json ./

# Instalar dependencias
RUN npm ci --omit=dev

# Copiar todo el backend
COPY backend/ ./

# Puerto
EXPOSE 3000

# Iniciar
CMD ["node", "server.js"]
```

5. Guarda el archivo (`Ctrl+S` o `Cmd+S`)

